# Browser-safe values only. Fill in ignored .env.local or Vercel settings.
# Production deploys: https://lume-house-delta.vercel.app; never use private keys here.
#
# Environment targeting (Slice 0):
#   - Local development, preview and build (`npm run dev|pre*/build`, `npm run preview`)
#     must target the STAGING Supabase project, never the production project.
#     `predev`, `prepreview` and `prebuild` run scripts/local-env-guard.mjs, which
#     refuses to start when an ignored local Vite env file carries the production
#     project reference in VITE_SUPABASE_URL. Values are never printed by the guard.
#   - Production values are injected by Vercel per environment (Production scope);
#     they are never stored in this repository. Staging values live in the Vercel
#     Preview scope and in ignored .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional same-origin callback URL. Default: current origin + /auth/callback.
# Add the exact URL to Supabase Auth redirect allowlist.
VITE_AUTH_REDIRECT_URL=
