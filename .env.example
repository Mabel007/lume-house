# Browser-safe values only. Fill in ignored .env.local or Vercel settings.
# Production: https://lume-house-delta.vercel.app; never use private keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional same-origin callback URL. Default: current origin + /auth/callback.
# Add the exact URL to Supabase Auth redirect allowlist.
VITE_AUTH_REDIRECT_URL=
