{
  "name": "lume-house",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/local-env-guard.mjs",
    "dev": "vite",
    "prebuild": "node scripts/local-env-guard.mjs",
    "build": "tsc -b && vite build",
    "prepreview": "node scripts/local-env-guard.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc -p supabase/functions/tsconfig.json",
    "lint": "eslint .",
    "cors:smoke": "node scripts/cors-smoke.mjs",
    "staging:guard": "node scripts/staging-target-guard.mjs",
    "test": "node scripts/test.mjs",
    "test:sql": "powershell -NoProfile -ExecutionPolicy Bypass -File supabase/tests/run-local.ps1",
    "test:sql:s02": "powershell -NoProfile -ExecutionPolicy Bypass -File supabase/tests/run-s02-slice-tests.ps1",
    "typecheck:functions:deno": "node scripts/check-functions-deno.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.13.0",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.2"
  }
}
